#!/bin/sh

set -eu

add_chum() {
	if [ "$#" -lt 2 ]
	then
		print_usage
		exit 1
	fi
	git config --global "chums.$1" "$2"
}

list_chums() {
	git config --get-regexp ^chums | cut -d. -f2-
}

set_active() {
	if [ "$#" -lt 1 ]
	then
		print_usage
		exit 1
	fi

	# Find git repo root
	repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
	if [ -z "$repo_root" ]
	then
		echo "Error: Not inside a git repository." >&2
		exit 1
	fi

	hook_path="$repo_root/.git/hooks/prepare-commit-msg"
	script_dir="$(cd "$(dirname "$0")" && pwd)"
	local_hook="$script_dir/prepare-commit-msg"

	if [ -f "$hook_path" ]
	then
		# Check for Co-authored-by in hook
		if ! grep -q "Co-authored-by" "$hook_path"
		then
			echo "Error: Existing prepare-commit-msg hook does not support Co-authored-by." >&2
			exit 1
		fi
		# Proceed as normal
	else
		# Install hook
		if [ ! -f "$local_hook" ]
		then
			echo "Error: prepare-commit-msg file not found in $script_dir." >&2
			exit 1
		fi
		cp "$local_hook" "$hook_path"
		chmod +x "$hook_path"
		echo "Installed prepare-commit-msg hook to $hook_path."
	fi

	unset_active
	for chum in "$@"
	do
		if ! git config --get "chums.$chum" >/dev/null
		then
			unset_active
			echo Unknown person: $chum >/dev/stderr
			exit 1
		fi
		git config --local --add active-chums.i "$chum"
	done
}

unset_active() {
	git config --local --remove-section active-chums 2>/dev/null || :
}

show_active() {
	if git config --local --get active-chums.i >/dev/null
	then
		for chum in `git config --local --get-all active-chums.i`
		do
			git config --get "chums.$chum"
		done
	else
		echo "No pairs currently set."
	fi
}

print_coauthors() {
	if ! git config --local --get active-chums.i >/dev/null
	then
		return
	fi
	printf "\n\n"
	OLDIFS="$IFS"
	IFS=`printf "\n\b"`
	for i in `git config --local --get-all active-chums.i`
	do
		printf "Co-authored-by: %s\n" `git config --get "chums.$i"`
	done
	IFS="$OLDIFS"
}

print_usage() {
	printf "Usage:\n" >/dev/stderr
	printf "  git pair { add | list | set | unset | show }\n" >/dev/stderr
	printf "\n" >/dev/stderr
	printf "add <initials> <email>\n" >/dev/stderr
	printf "\tAdd a new colleague's details\n\n" >/dev/stderr
	printf "list\n" >/dev/stderr
	printf "\tList all colleagues\n\n" >/dev/stderr
	printf "set <initials0, initials1, ...>\n" >/dev/stderr
	printf "\tSet the currently active pair (or mob)\n\n" >/dev/stderr
	printf "unset\n" >/dev/stderr
	printf "\tUnset the active pair (or mob)\n\n" >/dev/stderr
	printf "show\n" >/dev/stderr
	printf "\tDisplay the current active pair (or mob)\n\n" >/dev/stderr
}

if [ "$#" -lt 1 ]
then
	print_usage
	exit 1
fi

case "$1" in
	add)
		shift
		add_chum "$@"
		;;
	list)
		list_chums
		;;
	set)
		shift
		set_active "$@"
		;;
	unset)
		unset_active
		;;
	show)
		show_active
		;;
	print)
		print_coauthors
		;;
	*)
		print_usage
		exit 1
		;;
esac

